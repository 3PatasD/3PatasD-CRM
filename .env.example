# Base de datos PostgreSQL
# Formato: postgresql://usuario:contraseña@host:puerto/nombre_bd
DATABASE_URL="postgresql://crm_user:crm_password@localhost:5432/3patasd_crm"

# Clave secreta para firmar las sesiones JWT de NextAuth
# Generar con: openssl rand -base64 32
NEXTAUTH_SECRET="cambia-esto-en-produccion"

# URL base de la aplicación (sin barra final)
# En Docker con Cloudflare Tunnel usar la URL del tunnel
NEXTAUTH_URL="http://localhost:3000"
